[user]
	name = Audun Nes
	email = audun.nes@gmail.com
    signingkey = /Users/audun/.ssh/id_ed25519.pub
[alias]
	co = checkout
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /Users/audun/.ssh/allowedSignersFile
[pull]
	rebase = false
[credential "https://github.com"]
        helper =
        helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
        helper =
        helper = !/opt/homebrew/bin/gh auth git-credential
